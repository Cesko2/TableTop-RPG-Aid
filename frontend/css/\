.stat_box {
  display: flex;
  align-items: center;
  justify-content: center;
}

input, option {
  font-family: Sans-Serif;
}

.stat_box div {
  display: flex;
  margin: 5px;
  align-items: center;
  flex-direction: column;
  border: 3px double #a88b63;
  border-radius: 5px;
  background: #302923;
}

.stat_box div input {
  text-align: center;
  width: 45px;
  height: 50px;
  font-size: 25px;
  margin: 5px;
  background: #d4b18e;
  font-family: times new roman;
  border: 2px inset #302923;
}

input:focus {
  border-color: #d9791a !important;
  outline: none;
}

.dashboard-content .non_core {
  margin: 10px;
  border-radius: 20px;
  width: 80px;
  height: 100px;
}

.non_core input {
  border-radius: 20px;
}

.sheet {
  display: none;
}

.sheet_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sheet .d1 {
  padding: 10px;
}

.sheet .d2 {
  flex-direction: column;
  align-items: center;
}

.skills_list {
  display: flex;
}

.skill[data-stage="0"] {

}

.skill[data-stage="1"] {
  background-color: red;
}

.skill[data-stage="2"] {
  outline: 3px solid yellow;
}
